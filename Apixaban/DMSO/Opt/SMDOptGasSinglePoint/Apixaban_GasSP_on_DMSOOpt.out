NAME = Apixaban_GasSP_on_DMSOOpt.inp
|  1> # Apixaban: gas-phase single-point on a solvent-optimized geometry
|  2> # Purpose:
|  3> #   E_gas(X_solvent) for separating structural relaxation from solvation.
|  4> #
|  5> # Use the final optimized XYZ geometry from the corresponding SMD-Opt calculation.
|  6> # This calculation removes the SMD solvent model; only the gas-phase electronic
|  7> # energy at the solvent-optimized geometry is evaluated.
|  8> 
|  9> ! r2SCAN-3c TightSCF
| 10> 
| 11> %pal
| 12>   nprocs 4
| 13> end
| 14> 
| 15> %maxcore 2000
| 16> 
| 17> * xyzfile 0 1 Apixaban_SMD_dmso_Opt.xyz
| 18> 
