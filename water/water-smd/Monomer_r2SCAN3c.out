NAME = Monomer_r2SCAN3c.inp
|  1> # Water monomer in SMD(water), r2SCAN-3c
|  2> # Purpose: SMD(water) Opt + Freq + KeepDens at r2SCAN-3c, to match the level
|  3> #   used for the water tetramer (water-smd/4Water/..._restart) and for the
|  4> #   MeOH monomer (MeOH/Monomer.inp), so a like-for-like comparison of
|  5> #   interaction/stabilization energies is possible.
|  6> #
|  7> # NOTE: the existing water-smd/water_smd.inp is at a different level
|  8> #   (B3LYP/def2-SVP/D3BJ, SMD(water)) - this new calculation is the
|  9> #   r2SCAN-3c counterpart needed for consistency with the tetramer.
| 10> 
| 11> ! r2SCAN-3c TightSCF Opt Freq KeepDens SMD(water)
| 12> 
| 13> * xyz 0 1
| 14> O   0.0   0.0   0.1
| 15> H   0.0   0.7  -0.4
| 16> H   0.0  -0.7  -0.4
| 17> *
| 18> 
| 19>                          ****END OF INPUT****
